{
  "name": "@msclabs/gsc-cli",
  "version": "0.2.0",
  "description": "Google Search Console CLI — performance, coverage, URL inspection, sitemaps, and indexing. Agent-ready (JSON-on-pipe, NDJSON) with an `mcp serve` co-binary.",
  "type": "module",
  "bin": {
    "gsc": "./bin/gsc",
    "gsc-mcp": "./bin/gsc-mcp"
  },
  "files": [
    "dist/cli.cjs",
    "dist/mcp.cjs",
    "bin/",
    ".claude-plugin/plugin.json",
    "AGENTS.md",
    "SKILL.md",
    "README.md"
  ],
  "scripts": {
    "build": "node build.mjs",
    "dev": "tsx src/index.ts",
    "dev:mcp": "tsx src/mcp/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "bash scripts/smoke.sh"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "google-search-console",
    "search-console",
    "gsc",
    "seo",
    "url-inspection",
    "indexing-api",
    "sitemaps",
    "cli",
    "ai",
    "claude-code",
    "cursor",
    "codex",
    "gemini",
    "mcp",
    "agentic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/msclabs/gsc-cli.git"
  },
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.2.0",
    "@commander-js/extra-typings": "^14.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
